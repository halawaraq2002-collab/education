{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student or Admin user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "enrolledCourses": { "type": "array" },
        "completedLessons": { "type": "array" },
        "points": { "type": "number" },
        "badges": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course track and curriculum",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 150 },
        "titleEn": { "type": "string", "maxLength": 150 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "shortDescriptionEn": { "type": "string", "maxLength": 500 },
        "level": { "type": "string", "maxLength": 50 },
        "levelEn": { "type": "string", "maxLength": 50 },
        "duration": { "type": "string", "maxLength": 50 },
        "totalLessons": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "titleEn"]
    },
    "CourseProgress": {
      "title": "CourseProgress",
      "description": "Student progress for a specific course",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 64 },
        "completedLessonIds": { "type": "array" },
        "lastLessonId": { "type": "string", "maxLength": 64 },
        "quizScore": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "courseId"]
    },
    "QuizSubmission": {
      "title": "QuizSubmission",
      "description": "Submitted answers and score for a quiz",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 64 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "passed": { "type": "boolean" },
        "submittedAt": { "type": "string" }
      },
      "required": ["userId", "courseId", "score"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Managed academic courses available in the platform"
    },
    "/users/{userId}/progress/{courseId}": {
      "schema": "CourseProgress",
      "description": "Per-course progress for a student"
    },
    "/quizSubmissions/{submissionId}": {
      "schema": "QuizSubmission",
      "description": "Records of quiz attempts and grades"
    }
  }
}
